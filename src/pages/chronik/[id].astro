---
import { getChronicle } from '../../lib/chronicle';
import ChronicleArticle from '../../components/ChronicleArticle.astro';
import ChronicleYear from '../../components/ChronicleYear.astro';

export async function getStaticPaths() {
  const { entries, years, notes, press } = await getChronicle();

  return [
    ...entries.map((entry) => ({
      params: { id: entry.id },
      props: { entry, press: press[entry.id] ?? [] },
    })),
    ...years.map((year) => ({
      params: { id: String(year) },
      props: {
        year,
        notes: notes[year] ?? [],
        entries: entries.filter((entry) => entry.data.date.getUTCFullYear() === year),
        pressEntryIds: Object.keys(press),
      },
    })),
  ];
}

const props = Astro.props;
---

{
  'entry' in props
    ? <ChronicleArticle entry={props.entry} press={props.press} />
    : <ChronicleYear year={props.year} notes={props.notes} entries={props.entries} pressEntryIds={props.pressEntryIds} />
}
