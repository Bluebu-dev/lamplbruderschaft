---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageCarousel from '../../components/ImageCarousel.astro';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const entries = await getCollection('chronik');

  return entries.map((entry) => ({
    params: {
      id: entry.id,
    },
    props: {
      entry,
    },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const formattedDate = entry.data.date.toLocaleDateString('de-DE', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={`${entry.data.title} | Lamplbruderschaft`}
  description={entry.data.excerpt}
>
  <main class="chronicle-entry">

    <section class="article-hero">

      {
        entry.data.cover && (
          <div class="hero-image">
            <Image
              src={entry.data.cover}
              alt={entry.data.title}
              width={1600}
              class="hero-cover"
            />

            <div class="overlay"></div>
          </div>
        )
      }

      <div class="hero-content">
        <a class="back" href={`${base}chronik`}>
          ← Zur Chronik
        </a>

        <p class="date">{formattedDate}</p>

        <h1>{entry.data.title}</h1>

        <p class="excerpt">
          {entry.data.excerpt}
        </p>
      </div>

    </section>


    <article class="article-body">
      <Content />
    </article>


    {
      entry.data.gallery.length > 0 && (
        <ImageCarousel images={entry.data.gallery} />
      )
    }

  </main>
</BaseLayout>

<style>
  .chronicle-entry {
    background: var(--color-background);
  }

  /* HERO */

  .article-hero {
    position: relative;

    max-width: 1400px;
    min-height: 620px;

    margin: 3rem auto 0;

    display: flex;
    align-items: flex-end;

    overflow: hidden;

    background: var(--color-dark);
    color: white;
  }

  .hero-image {
    position: absolute;
    inset: 0;
  }

  .hero-cover {
    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  .overlay {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        to top,
        rgba(20, 16, 13, 0.88) 0%,
        rgba(20, 16, 13, 0.55) 45%,
        rgba(20, 16, 13, 0.15) 100%
      );
  }

  .hero-content {
    position: relative;
    z-index: 1;

    width: 100%;
    max-width: 1000px;

    padding: 5rem;
  }

  .back {
    display: inline-block;

    margin-bottom: 4rem;

    font-size: 0.9rem;
    font-weight: bold;

    text-decoration: none;
  }

  .date {
    margin: 0 0 1rem;

    font-size: 0.8rem;
    font-weight: bold;

    letter-spacing: 0.14em;
    text-transform: uppercase;

    color: var(--color-gold);
  }

  h1 {
    max-width: 900px;

    margin: 0;

    font-size: clamp(3rem, 6vw, 6rem);
    line-height: 0.95;
  }

  .excerpt {
    max-width: 700px;

    margin: 2rem 0 0;

    font-size: 1.25rem;
    line-height: 1.6;

    color: #eee7df;
  }

  /* ARTIKEL */

  .article-body {
    max-width: 760px;

    margin: 0 auto;
    padding: 6rem 2rem;

    font-size: 1.1rem;
    line-height: 1.85;

    color: var(--color-dark);
  }

  .article-body :global(h2) {
    margin: 4rem 0 1.5rem;

    font-size: 2rem;
    line-height: 1.2;
  }

  .article-body :global(h3) {
    margin: 3rem 0 1rem;

    font-size: 1.5rem;
  }

  .article-body :global(p) {
    margin: 0 0 1.5rem;
  }

  .article-body :global(a) {
    color: var(--color-primary);
  }

  .article-body :global(blockquote) {
    margin: 3rem 0;
    padding-left: 2rem;

    border-left: 3px solid var(--color-primary);

    font-size: 1.25rem;
    font-style: italic;

    color: var(--color-muted);
  }

  /* MOBILE */

  @media (max-width: 800px) {
    .article-hero {
      min-height: 520px;
      margin-top: 0;
    }

    .hero-content {
      padding: 3rem 1.5rem;
    }

    .back {
      margin-bottom: 3rem;
    }

    .article-body {
      padding: 4rem 1.5rem;
    }
  }
</style>