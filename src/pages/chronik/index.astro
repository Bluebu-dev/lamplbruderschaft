---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChronicleCard from '../../components/ChronicleCard.astro';
import { getChronicle } from '../../lib/chronicle';

const base = import.meta.env.BASE_URL;
const { entries, years } = await getChronicle();
---

<BaseLayout
  title="Chronik | Lamplbruderschaft zu Passau"
  description="Neuigkeiten, Veranstaltungen und Ereignisse aus dem Leben der Lamplbruderschaft zu Passau."
>
  <main class="editorial-page">
    <header class="editorial-header container">
      <h1>Chronik</h1>
      <p>Ereignisse, Begegnungen und Geschichten aus dem Leben der Lamplbruderschaft.</p>
    </header>

    <section id="jahresarchiv" class="editorial-section container archive">
      <h2>Jahresarchiv</h2>
      <nav aria-label="Jahrgänge">
        <ul class="years">
          {years.map((year) => <li><a href={`${base}chronik/${year}/`}>{year}</a></li>)}
        </ul>
      </nav>
    </section>

    <section class="editorial-section container">
      <h2>Beiträge</h2>
      <div class="grid">
        {entries.map((entry) => (
          <ChronicleCard
            title={entry.data.title}
            date={entry.data.date}
            excerpt={entry.data.excerpt}
            cover={entry.data.cover}
            href={`${base}chronik/${entry.id}/`}
          />
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .archive {
    padding-block: 1.25rem 2.25rem;
  }

  .years {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .years a {
    display: block;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 0.2rem;
    background: var(--color-background-alt);
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }

  .years a:hover,
  .years a:focus-visible {
    border-color: var(--color-primary);
    text-decoration: underline;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17.5rem), 1fr));
    align-items: start;
    gap: 2.5rem 1.5rem;
  }
</style>
