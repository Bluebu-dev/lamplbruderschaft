---
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const heroImage = `${base}images/passau.jpg`;
---

<section class="hero" style={`--hero-image: url('${heroImage}')`}>
  <div class="hero-content">
    <p class="eyebrow">Seit Jahrhunderten in Passau</p>

    <h1>
      Lamplbruderschaft
      <span>Unserer lieben Frau Bruderschaft der Schiffleuut und Salzfertiger zu Passau</span>
    </h1>

    <p class="intro">
      Gemeinschaft, Tradition und gelebte Verbundenheit mit der Stadt Passau.
    </p>

    <a href={`${base}geschichte`} class="button">
      Unsere Geschichte
    </a>
  </div>
</section>

<style>
  .hero {
    min-height: 85vh;

    display: flex;
    align-items: center;

    position: relative;

    background:
      linear-gradient(
        rgba(30, 20, 15, 0.35),
        rgba(30, 20, 15, 0.65)
      ),
      var(--hero-image);

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;

    color: white;
  }

  .hero-content {
    width: min(1200px, calc(100% - 4rem));
    margin: 0 auto;

    padding: 8rem 0 5rem;
  }

  .eyebrow {
    margin-bottom: 1rem;

    font-size: 0.9rem;
    font-weight: bold;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 800px;

    margin: 0;

    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 0.95;
  }

  h1 span {
    display: block;

    margin-top: 0.5rem;

    font-size: 0.55em;
    font-weight: normal;
  }

  .intro {
    max-width: 600px;

    margin: 2rem 0;

    font-size: 1.3rem;
    line-height: 1.6;
  }

  .button {
    display: inline-block;

    padding: 0.9rem 1.5rem;

    background: white;
    color: #24211d;

    text-decoration: none;
    font-weight: bold;
  }

  .button:hover {
    background: #eee8dc;
  }
</style>