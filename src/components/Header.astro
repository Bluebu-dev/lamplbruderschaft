---
const base = import.meta.env.BASE_URL;

import { Image } from 'astro:assets';
import logo from '../assets/Bahrtuchschild.jpg';
import '../styles/global.css';

---

<header class="site-header">
  <div class="header-container">
    <a class="brand" href={base}>
      <Image
        class="brand-logo"
        src={logo}
        alt="Wappen der Lamplbruderschaft"
        width={64}
        height={64}
      />

      <span class="brand-text">
        <span class="brand-main">Lamplbruderschaft</span>
        <span class="brand-sub">Passau</span>
      </span>
    </a>

    <nav aria-label="Hauptnavigation">
      <a href={base}>Startseite</a>
      <a href={`${base}geschichte`}>Geschichte</a>
      <a href={`${base}bruderschaft`}>Bruderschaft</a>
      <a href={`${base}chronik`}>Chronik</a>
      <a href={`${base}kontakt`}>Kontakt</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: #f7f4ee;
    border-bottom: 1px solid #d9d0c3;
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.4rem 2rem;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 2rem;
  }

  nav {
    display: flex;
    gap: 1.8rem;
  }

  nav a {
    color: #24211d;
    text-decoration: none;
    font-size: 0.95rem;
  }

  nav a:hover {
    text-decoration: underline;
  }

  @media (max-width: 800px) {
    nav {
      display: none;
    }
  }
</style>