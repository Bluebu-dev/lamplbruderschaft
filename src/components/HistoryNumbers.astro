---
import HistoryFact from './HistoryFact.astro';
---

<section class="history">
  <div class="container">

    <header class="history-header">
      <p class="eyebrow">Passauer Geschichte</p>

      <h2>
        Mehr als sieben Jahrhunderte
        <span>Bruderschaft.</span>
      </h2>
    </header>

    <div class="facts">

      <HistoryFact
        year="1306"
        title="Erste urkundliche Erwähnung"
        text="Bereits im frühen 14. Jahrhundert ist die Gemeinschaft der Passauer Schiffsleute und Salzfertiger urkundlich belegt."
      />

      <HistoryFact
        year="1604"
        title="Magnus Lampl"
        text="Die Stiftung des Passauer Bürgers Magnus Lampl prägt die Bruderschaft und gibt ihr schließlich ihren heutigen Namen."
      />

      <HistoryFact
        year="700+"
        title="Jahre Passauer Tradition"
        text="Über Jahrhunderte hinweg blieb der Gedanke der Gemeinschaft und gegenseitigen Hilfe lebendig."
      />

    </div>

    <div class="history-link">
      <a href="/geschichte">
        Die ganze Geschichte entdecken
        <span aria-hidden="true">→</span>
      </a>
    </div>

  </div>
</section>

<style>
  .history {
    padding: 8rem 2rem;

    background: #eee8dc;
    color: #24211d;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .history-header {
    max-width: 850px;

    margin-bottom: 5rem;
  }

  .eyebrow {
    margin: 0 0 1.25rem;

    font-size: 0.8rem;
    font-weight: bold;
    letter-spacing: 0.16em;
    text-transform: uppercase;

    color: #7a1f1f;
  }

  h2 {
    margin: 0;

    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: 1.05;
  }

  h2 span {
    display: block;

    font-weight: normal;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);

    gap: 4rem;

    padding: 2rem 0 4rem;

    border-top: 1px solid #c9bfae;
    border-bottom: 1px solid #c9bfae;
  }

  .history-link {
    margin-top: 3rem;

    display: flex;
    justify-content: flex-end;
  }

  .history-link a {
    display: flex;
    gap: 1rem;
    align-items: center;

    color: #24211d;

    font-weight: bold;
    text-decoration: none;
  }

  .history-link span {
    font-size: 1.5rem;

    transition: transform 0.2s ease;
  }

  .history-link a:hover span {
    transform: translateX(0.4rem);
  }

  @media (max-width: 800px) {
    .history {
      padding: 5rem 1.5rem;
    }

    .history-header {
      margin-bottom: 3rem;
    }

    .facts {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .history-link {
      justify-content: flex-start;
    }
  }
</style>