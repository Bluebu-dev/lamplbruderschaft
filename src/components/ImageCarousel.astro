---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryImage {
  image: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

{
  images.length > 0 && (
    <section class="gallery">

      <div class="gallery-header">
        <div>
          <p class="eyebrow">Impressionen</p>
          <h2>Bilder des Tages</h2>
        </div>

        {
          images.length > 1 && (
            <div class="controls">
              <button
                class="previous"
                type="button"
                aria-label="Vorheriges Bild"
              >
                ←
              </button>

              <button
                class="next"
                type="button"
                aria-label="Nächstes Bild"
              >
                →
              </button>
            </div>
          )
        }
      </div>

      <div class="carousel">

        {
          images.map((item) => (
            <figure class="slide">

              <Image
                src={item.image}
                alt={item.alt}
                width={1200}
              />

              {
                item.caption && (
                  <figcaption>
                    {item.caption}
                  </figcaption>
                )
              }

            </figure>
          ))
        }

      </div>

    </section>
  )
}

<script>
  document.querySelectorAll('.gallery').forEach((gallery) => {

    const carousel =
      gallery.querySelector<HTMLElement>('.carousel');

    const previous =
      gallery.querySelector<HTMLButtonElement>('.previous');

    const next =
      gallery.querySelector<HTMLButtonElement>('.next');

    if (!carousel) {
      return;
    }

    previous?.addEventListener('click', () => {
      carousel.scrollBy({
        left: -carousel.clientWidth,
        behavior: 'smooth',
      });
    });

    next?.addEventListener('click', () => {
      carousel.scrollBy({
        left: carousel.clientWidth,
        behavior: 'smooth',
      });
    });

  });
</script>

<style>
  .gallery {
    max-width: 1200px;

    margin: 3rem auto 0;
    padding: 6rem 2rem;
  }

  .gallery-header {
    display: flex;

    justify-content: space-between;
    align-items: end;

    gap: 3rem;

    margin-bottom: 2rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;

    font-size: 0.8rem;
    font-weight: bold;

    letter-spacing: 0.16em;
    text-transform: uppercase;

    color: var(--color-primary);
  }

  h2 {
    margin: 0;

    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  .controls {
    display: flex;
    gap: 0.5rem;
  }

  button {
    width: 3rem;
    height: 3rem;

    border: 1px solid var(--color-border);

    background: transparent;
    color: var(--color-dark);

    font-size: 1.3rem;

    cursor: pointer;

    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  button:hover {
    background: var(--color-dark);
    color: var(--color-background);
  }

  .carousel {
    display: flex;

    overflow-x: auto;

    scroll-snap-type: x mandatory;

    scrollbar-width: none;
  }

  .carousel::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 100%;

    margin: 0;

    scroll-snap-align: start;
  }

  .slide img {
    display: block;

    width: 100%;
    height: auto;

    aspect-ratio: 16 / 9;

    object-fit: cover;
  }

  figcaption {
    margin-top: 1rem;

    font-size: 0.9rem;
    font-style: italic;

    color: var(--color-muted);
  }

  @media (max-width: 800px) {
    .gallery {
      padding: 4rem 1.5rem;
    }

    .gallery-header {
      align-items: flex-start;
    }
  }
</style>